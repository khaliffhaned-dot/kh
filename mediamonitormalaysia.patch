+          )}
+          <Button
+            variant="outline"
+            size="sm"
+            onClick={() => load(activeQuery)}
+            disabled={loading}
+          >
+            <RefreshCw
+              className={loading ? "h-3.5 w-3.5 animate-spin" : "h-3.5 w-3.5"}
+              aria-hidden
+            />
+            <span className="ml-1.5">Refresh</span>
+          </Button>
+        </div>
+      </div>
+
+      {error && (
+        <Card className="border-destructive/50">
+          <CardContent className="flex items-center gap-2 py-4 text-sm">
+            <AlertTriangle className="h-4 w-4 text-destructive" aria-hidden />
+            {error} — check your connection and refresh.
+          </CardContent>
+        </Card>
+      )}
+
+      {/* ── Stat tiles ────────────────────────────────────────────── */}
+      {loading && !data ? (
+        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
+          {Array.from({ length: 4 }).map((_, i) => (
+            <Skeleton key={i} className="h-24" />
+          ))}
+        </div>
+      ) : (
+        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
+          <StatTile
+            label="Mentions (7 days)"
+            value={String(stats.total)}
+            hint={activeQuery ? `for “${activeQuery}”` : "all coverage"}
+          />
+          <StatTile
+            label="Net sentiment"
+            value={`${stats.net > 0 ? "+" : ""}${stats.net}%`}
+            hint={`${stats.pos} positive · ${stats.neg} negative`}
+          />
+          <StatTile
+            label="Negative mentions"
+            value={String(stats.neg)}
+            hint="potential issues to review"
+          />
+          <StatTile
+            label="Sources reporting"
+            value={String(stats.sourcesOk)}
+            hint={
+              failedSources.length > 0
+                ? `${failedSources.length} feed(s) unreachable`
+                : "all feeds healthy"
+            }
+          />
+        </div>
+      )}
+
+      {/* ── Charts ────────────────────────────────────────────────── */}
+      {loading && !data ? (
+        <div className="grid gap-4 lg:grid-cols-3">
+          {Array.from({ length: 3 }).map((_, i) => (
+            <Skeleton key={i} className="h-72" />
+          ))}
+        </div>
+      ) : (
+        articles.length > 0 && (
+          <div className="grid gap-4 lg:grid-cols-3">
+            <SentimentTimeline articles={articles} />
+            <ShareOfVoice articles={articles} />
+            <LanguageMix articles={articles} />
+          </div>
+        )
+      )}
+
+      {/* ── Feed ──────────────────────────────────────────────────── */}
+      <div>
+        <h2 className="mb-3 text-lg font-semibold text-foreground">
+          Latest mentions{" "}
+          <span className="text-sm font-normal text-muted-foreground">
+            ({articles.length})
+          </span>
+        </h2>
+        {loading && !data ? (
+          <div className="space-y-3">
+            {Array.from({ length: 5 }).map((_, i) => (
+              <Skeleton key={i} className="h-28" />
+            ))}
+          </div>
+        ) : (
+          <ArticleFeed articles={articles} />
+        )}
+      </div>
+
+      {failedSources.length > 0 && (
+        <details className="text-xs text-muted-foreground">
+          <summary className="cursor-pointer">
+            {failedSources.length} feed(s) could not be reached this refresh
+          </summary>
+          <ul className="mt-2 list-inside list-disc space-y-1">
+            {failedSources.map((s) => (
+              <li key={s.sourceId}>
+                {s.sourceName} — {s.error}
+              </li>
+            ))}
+          </ul>
+        </details>
+      )}
+    </div>
+  );
+}
