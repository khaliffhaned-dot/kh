+"use client";
+
+import { formatDistanceToNow } from "date-fns";
+import { ExternalLink, Minus, ThumbsDown, ThumbsUp } from "lucide-react";
+import { Badge } from "@/components/ui/badge";
+import { Card, CardContent } from "@/components/ui/card";
+import type { AnalyzedArticle, SentimentLabel } from "@/lib/monitor/types";
+import { LANGUAGE_LABELS } from "./colors";
+import { cn } from "@/lib/utils";
+
+// Sentiment is icon + label, never color alone.
+const SENTIMENT_META: Record<
+  SentimentLabel,
+  { label: string; icon: typeof ThumbsUp; className: string }
+> = {
+  positive: {
+    label: "Positive",
+    icon: ThumbsUp,
+    className: "border-[#0ca30c]/50 text-[#2fc42f]",
+  },
+  neutral: {
+    label: "Neutral",
+    icon: Minus,
+    className: "border-muted-foreground/50 text-muted-foreground",
+  },
+  negative: {
+    label: "Negative",
+    icon: ThumbsDown,
+    className: "border-[#e66767]/50 text-[#e66767]",
+  },
+};
+
+export function ArticleFeed({ articles }: { articles: AnalyzedArticle[] }) {
+  if (articles.length === 0) {
+    return (
+      <Card>
+        <CardContent className="py-12 text-center text-muted-foreground">
+          No mentions found in the last 7 days. Try a broader keyword, or
+          leave the search empty to see everything the Malaysian press is
+          publishing right now.
+        </CardContent>
+      </Card>
+    );
+  }
+
+  return (
+    <div className="space-y-3">
+      {articles.map((a) => {
+        const meta = SENTIMENT_META[a.sentiment.label];
+        const Icon = meta.icon;
+        return (
+          <Card key={a.link} className="transition-colors hover:border-accent/60">
+            <CardContent className="p-4">
+              <div className="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
+                <span className="font-semibold text-foreground/80">
+                  {a.sourceName}
+                </span>
+                <span aria-hidden>·</span>
+                <span>{LANGUAGE_LABELS[a.language]}</span>
+                {a.publishedAt && (
+                  <>
+                    <span aria-hidden>·</span>
+                    <time dateTime={a.publishedAt}>
+                      {formatDistanceToNow(new Date(a.publishedAt), {
+                        addSuffix: true,
+                      })}
+                    </time>
+                  </>
+                )}
+                <Badge
+                  variant="outline"
+                  className={cn("ml-auto gap-1 font-normal", meta.className)}
+                >
+                  <Icon className="h-3 w-3" aria-hidden />
+                  {meta.label}
+                </Badge>
+              </div>
+              <a
+                href={a.link}
+                target="_blank"
+                rel="noopener noreferrer"
+                className="mt-2 block font-semibold leading-snug text-foreground hover:text-primary"
+              >
+                {a.title}
+                <ExternalLink
+                  className="ml-1 inline h-3.5 w-3.5 opacity-50"
+                  aria-hidden
+                />
+              </a>
+              {a.description && (
+                <p className="mt-1 line-clamp-2 text-sm text-muted-foreground">
+                  {a.description}
+                </p>
+              )}
+              {a.entities.length > 0 && (
+                <div className="mt-2 flex flex-wrap gap-1.5">
+                  {a.entities.slice(0, 6).map((e) => (
+                    <Badge
+                      key={e.name}
+                      variant="secondary"
+                      className="text-[10px] font-normal"
+                    >
+                      {e.name}
+                    </Badge>
+                  ))}
+                </div>
+              )}
+            </CardContent>
+          </Card>
+        );
+      })}
+    </div>
+  );
+}
