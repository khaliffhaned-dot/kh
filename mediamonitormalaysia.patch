+export type MonitorLanguage = "ms" | "en" | "zh" | "ta" | "mixed";
+
+export type SentimentLabel = "positive" | "neutral" | "negative";
+
+export type SourceCategory =
+  | "mainstream"
+  | "online"
+  | "business"
+  | "regional"
+  | "aggregator"
+  | "community";
+
+export type SourceRegion = "national" | "sabah" | "sarawak";
+
+export interface MonitorSource {
+  id: string;
+  name: string;
+  feedUrl: string;
+  homepage: string;
+  language: MonitorLanguage;
+  category: SourceCategory;
+  region: SourceRegion;
+}
+
+export interface FeedItem {
+  title: string;
+  link: string;
+  description: string;
+  publishedAt: string | null;
+  sourceId: string;
+  sourceName: string;
+}
+
+export type EntityType =
+  | "party"
+  | "government"
+  | "company"
+  | "place"
+  | "issue";
+
+export interface EntityMatch {
+  name: string;
+  type: EntityType;
+}
+
+export interface SentimentResult {
+  label: SentimentLabel;
+  /** Normalised score in [-1, 1]. */
+  score: number;
+  /** Lexicon terms that drove the score, for transparency. */
+  signals: string[];
+}
+
+export interface AnalyzedArticle extends FeedItem {
+  language: MonitorLanguage;
+  sentiment: SentimentResult;
+  entities: EntityMatch[];
+}
+
+export interface SourceFetchStatus {
+  sourceId: string;
+  sourceName: string;
+  ok: boolean;
+  itemCount: number;
+  error?: string;
+}
+
+export interface MonitorResponse {
+  articles: AnalyzedArticle[];
+  sources: SourceFetchStatus[];
+  fetchedAt: string;
+  query: string;
+}
