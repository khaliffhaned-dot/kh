+import { NextRequest, NextResponse } from "next/server";
+import { MONITOR_SOURCES, googleNewsSources } from "@/lib/monitor/sources";
+import { parseFeed } from "@/lib/monitor/rss";
+import {
+  analyzeArticle,
+  dedupeArticles,
+  matchesQuery,
+} from "@/lib/monitor/analyze";
+import type {
+  AnalyzedArticle,
+  MonitorResponse,
+  MonitorSource,
+  SourceFetchStatus,
+} from "@/lib/monitor/types";
+
+export const dynamic = "force-dynamic";
+
+const FETCH_TIMEOUT_MS = 8000;
+const MAX_ARTICLES = 200;
+const WINDOW_DAYS = 7;
+
+async function fetchSource(
+  source: MonitorSource
+): Promise<{ status: SourceFetchStatus; articles: AnalyzedArticle[] }> {
+  try {
+    const res = await fetch(source.feedUrl, {
+      signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
+      headers: {
+        // Some Malaysian CDNs (and Reddit) reject requests without a UA.
+        "User-Agent":
+          "Mozilla/5.0 (compatible; MYMediaMonitor/1.0; +https://github.com/khaliffhaned-dot/kh)",
+        Accept: "application/rss+xml, application/atom+xml, application/xml, text/xml, */*",
+      },
+      // Be polite to publishers: reuse feed responses for 5 minutes.
+      next: { revalidate: 300 },
+    });
+    if (!res.ok) {
+      return {
+        status: {
+          sourceId: source.id,
+          sourceName: source.name,
+          ok: false,
+          itemCount: 0,
+          error: `HTTP ${res.status}`,
+        },
+        articles: [],
+      };
+    }
+    const xml = await res.text();
+    const items = parseFeed(xml, source);
+    return {
+      status: {
+        sourceId: source.id,
+        sourceName: source.name,
+        ok: true,
+        itemCount: items.length,
+      },
+      articles: items.map(analyzeArticle),
+    };
+  } catch (err) {
+    return {
+      status: {
+        sourceId: source.id,
+        sourceName: source.name,
+        ok: false,
+        itemCount: 0,
+        error: err instanceof Error ? err.message : "fetch failed",
+      },
+      articles: [],
+    };
+  }
+}
+
+export async function GET(req: NextRequest) {
+  const query = (req.nextUrl.searchParams.get("q") ?? "").slice(0, 200).trim();
+
+  let sources = [...MONITOR_SOURCES];
+  // A tracked keyword also queries Google News MY (EN + BM) so coverage
+  // extends beyond the curated feeds.
+  if (query) {
+    sources = sources.concat(googleNewsSources(query.split(",")[0].trim()));
+  }
+
+  const results = await Promise.all(sources.map(fetchSource));
+
+  const cutoff = Date.now() - WINDOW_DAYS * 24 * 60 * 60 * 1000;
+  const articles = dedupeArticles(
+    results
+      .flatMap((r) => r.articles)
+      .filter((a) => !query || matchesQuery(a, query))
+      .filter((a) => !a.publishedAt || new Date(a.publishedAt).getTime() >= cutoff)
+  )
+    .sort((a, b) => {
+      const ta = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
+      const tb = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
+      return tb - ta;
+    })
+    .slice(0, MAX_ARTICLES);
+
+  const body: MonitorResponse = {
+    articles,
+    sources: results.map((r) => r.status),
+    fetchedAt: new Date().toISOString(),
+    query,
+  };
+
+  return NextResponse.json(body, {
+    headers: { "Cache-Control": "no-store" },
+  });
+}
