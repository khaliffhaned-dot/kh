+import type { MonitorLanguage, SentimentLabel } from "@/lib/monitor/types";
+
+/**
+ * Chart palette validated (CVD separation, lightness band, ≥3:1 contrast)
+ * against this app's dark card surface (#253346). Sentiment uses a
+ * diverging pair with a deliberate neutral-gray midpoint; languages use
+ * fixed categorical slots so a language keeps its hue across filters.
+ */
+export const SENTIMENT_COLORS: Record<SentimentLabel, string> = {
+  positive: "#0ca30c",
+  neutral: "#898781",
+  negative: "#e66767",
+};
+
+export const LANGUAGE_COLORS: Record<MonitorLanguage, string> = {
+  ms: "#3987e5",
+  en: "#199e70",
+  zh: "#c98500",
+  ta: "#9085e9",
+  mixed: "#898781",
+};
+
+export const LANGUAGE_LABELS: Record<MonitorLanguage, string> = {
+  ms: "Bahasa Malaysia",
+  en: "English",
+  zh: "中文 (Chinese)",
+  ta: "தமிழ் (Tamil)",
+  mixed: "Rojak / Mixed",
+};
+
+export const SINGLE_SERIES_COLOR = "#3987e5";
