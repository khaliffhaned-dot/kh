+// original text — "pas" the word vs "PAS" the party, "mas" vs "MAS".
+const UPPERCASE_ONLY = new Set([
+  "pas", "dap", "gps", "grs", "muda", "mca", "mic", "pkr", "mara", "padu",
+  "str ", "tol ",
+]);
+
+function containsAlias(
+  lowerText: string,
+  rawText: string,
+  alias: string
