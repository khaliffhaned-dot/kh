+import { detectLanguage } from "./language";
+import { analyzeSentiment } from "./sentiment";
+import { extractEntities } from "./entities";
+import type { AnalyzedArticle, FeedItem } from "./types";
+
+export function analyzeArticle(item: FeedItem): AnalyzedArticle {
+  const text = `${item.title}. ${item.description}`;
+  return {
+    ...item,
+    language: detectLanguage(text),
+    sentiment: analyzeSentiment(text),
+    entities: extractEntities(text),
+  };
+}
+
+/** Case-insensitive keyword filter; comma separates OR terms. */
+export function matchesQuery(item: FeedItem, query: string): boolean {
+  const terms = query
+    .split(",")
+    .map((t) => t.trim().toLowerCase())
+    .filter(Boolean);
+  if (terms.length === 0) return true;
+  const haystack = `${item.title} ${item.description}`.toLowerCase();
+  return terms.some((t) => haystack.includes(t));
+}
+
+/** Dedupe near-identical stories (same link, or same normalised title). */
+export function dedupeArticles<T extends FeedItem>(items: T[]): T[] {
+  const seen = new Set<string>();
+  const out: T[] = [];
+  for (const item of items) {
+    const titleKey = item.title
+      .toLowerCase()
+      .replace(/[^a-z0-9一-鿿]+/g, " ")
+      .trim()
+      .slice(0, 80);
+    const linkKey = item.link.replace(/[?#].*$/, "");
+    if (seen.has(titleKey) || seen.has(linkKey)) continue;
+    seen.add(titleKey);
+    seen.add(linkKey);
+    out.push(item);
+  }
+  return out;
+}
