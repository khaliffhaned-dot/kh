+        {hint && <p className="mt-1 text-xs text-muted-foreground">{hint}</p>}
+      </CardContent>
+    </Card>
+  );
+}
+
+export function MonitorDashboard() {
+  const [queryInput, setQueryInput] = useState("");
+  const [activeQuery, setActiveQuery] = useState("");
+  const [savedKeywords, setSavedKeywords] = useState<string[]>([]);
+  const [data, setData] = useState<MonitorResponse | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+
+  const [langFilter, setLangFilter] = useState<MonitorLanguage | "all">("all");
+  const [sentimentFilter, setSentimentFilter] = useState<
+    SentimentLabel | "all"
+  >("all");
+
+  useEffect(() => {
+    try {
+      const raw = localStorage.getItem(KEYWORDS_STORAGE_KEY);
+      if (raw) setSavedKeywords(JSON.parse(raw));
+    } catch {
+      // localStorage unavailable (private mode) — tracking chips just won't persist.
+    }
+  }, []);
+
+  const persistKeywords = useCallback((keywords: string[]) => {
+    setSavedKeywords(keywords);
+    try {
+      localStorage.setItem(KEYWORDS_STORAGE_KEY, JSON.stringify(keywords));
+    } catch {
+      // Non-fatal.
+    }
+  }, []);
+
+  const load = useCallback(async (query: string) => {
+    setLoading(true);
+    setError(null);
+    try {
+      const res = await fetch(
+        `/api/monitor?q=${encodeURIComponent(query)}`,
+        { cache: "no-store" }
+      );
+      if (!res.ok) throw new Error(`Request failed (HTTP ${res.status})`);
+      setData((await res.json()) as MonitorResponse);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Something went wrong");
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    load(activeQuery);
+  }, [activeQuery, load]);
+
+  const runSearch = (q: string) => {
+    setQueryInput(q);
+    setActiveQuery(q.trim());
+  };
+
+  const trackKeyword = () => {
+    const q = queryInput.trim();
+    if (!q || savedKeywords.includes(q)) return;
+    persistKeywords([...savedKeywords, q]);
+  };
+
+  const articles = useMemo(() => {
+    let list: AnalyzedArticle[] = data?.articles ?? [];
+    if (langFilter !== "all") list = list.filter((a) => a.language === langFilter);
+    if (sentimentFilter !== "all")
+      list = list.filter((a) => a.sentiment.label === sentimentFilter);
+    return list;
+  }, [data, langFilter, sentimentFilter]);
+
+  const stats = useMemo(() => {
+    const total = articles.length;
+    const pos = articles.filter((a) => a.sentiment.label === "positive").length;
+    const neg = articles.filter((a) => a.sentiment.label === "negative").length;
+    const net = total === 0 ? 0 : Math.round(((pos - neg) / total) * 100);
+    const sourcesOk = data?.sources.filter((s) => s.ok && s.itemCount > 0) ?? [];
+    return { total, pos, neg, net, sourcesOk: sourcesOk.length };
+  }, [articles, data]);
+
+  const failedSources = data?.sources.filter((s) => !s.ok) ?? [];
+
+  return (
+    <div className="space-y-6">
+      {/* ── Search & tracked keywords ─────────────────────────────── */}
+      <Card>
+        <CardHeader className="pb-4">
+          <CardTitle className="flex items-center gap-2 text-lg">
+            <Newspaper className="h-5 w-5 text-primary" aria-hidden />
+            Keyword monitor
+          </CardTitle>
+          <CardDescription>
+            Track a brand, name or isu semasa across Malaysian media — BM,
+            English, Chinese and Tamil outlets, plus Google News MY. Separate
+            alternatives with commas (e.g. “banjir, flood”).
+          </CardDescription>
+        </CardHeader>
+        <CardContent className="space-y-3">
+          <form
+            className="flex flex-col gap-2 sm:flex-row"
+            onSubmit={(e) => {
+              e.preventDefault();
+              setActiveQuery(queryInput.trim());
+            }}
+          >
+            <div className="relative flex-1">
+              <Search
+                className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"
+                aria-hidden
+              />
+              <Input
+                value={queryInput}
+                onChange={(e) => setQueryInput(e.target.value)}
+                placeholder="e.g. Petronas, subsidi diesel, banjir…"
+                className="pl-9"
+                aria-label="Search keyword"
+              />
+            </div>
+            <div className="flex gap-2">
+              <Button type="submit" disabled={loading}>
+                {loading ? (
+                  <Loader2 className="mr-2 h-4 w-4 animate-spin" aria-hidden />
+                ) : (
+                  <Search className="mr-2 h-4 w-4" aria-hidden />
+                )}
+                Search
+              </Button>
+              <Button
+                type="button"
+                variant="secondary"
+                onClick={trackKeyword}
+                disabled={!queryInput.trim()}
+              >
+                <Bookmark className="mr-2 h-4 w-4" aria-hidden />
+                Track
+              </Button>
+            </div>
+          </form>
+
+          {savedKeywords.length > 0 && (
+            <div className="flex flex-wrap items-center gap-2">
+              <span className="text-xs text-muted-foreground">Tracked:</span>
+              {savedKeywords.map((kw) => (
