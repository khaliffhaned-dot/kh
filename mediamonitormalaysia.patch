--- /dev/null
+++ b/src/lib/monitor/language.ts
@@ -0,0 +1,64 @@
+import type { MonitorLanguage } from "./types";
+
+/**
+ * Lightweight language detection tuned for the Malaysian media mix:
+ * Bahasa Malaysia, English, Chinese and Tamil — plus "mixed" for the
+ * bahasa rojak / Manglish register common on social-leaning outlets.
+ */
+
+const MALAY_STOPWORDS = new Set([
+  "yang", "dan", "untuk", "dengan", "kepada", "daripada", "dalam", "pada",
+  "adalah", "ialah", "ini", "itu", "tidak", "tak", "akan", "telah", "sudah",
+  "belum", "boleh", "kerana", "seperti", "juga", "lagi", "bagi", "oleh",
+  "atau", "jika", "kata", "berkata", "mengenai", "terhadap", "selepas",
+  "sebelum", "ketika", "semasa", "antara", "iaitu", "ini", "kami", "kita",
+  "mereka", "beliau", "anda", "saya", "tersebut", "berkenaan", "sahaja",
+  "hanya", "paling", "sangat", "amat", "para", "setiap", "semua", "ramai",
+]);
+
+const ENGLISH_STOPWORDS = new Set([
+  "the", "and", "for", "with", "that", "this", "from", "have", "has",
+  "was", "were", "are", "will", "would", "been", "their", "they", "his",
+  "her", "its", "not", "but", "after", "before", "when", "while", "about",
+  "over", "under", "more", "than", "also", "into", "out", "who", "which",
+  "what", "there", "where", "says", "said", "can", "could", "should",
+]);
+
+export function detectLanguage(text: string): MonitorLanguage {
+  const chars = [...text];
+  if (chars.length === 0) return "en";
+
+  let cjk = 0;
+  let tamil = 0;
+  for (const ch of chars) {
+    const code = ch.codePointAt(0)!;
+    if (
+      (code >= 0x4e00 && code <= 0x9fff) ||
+      (code >= 0x3400 && code <= 0x4dbf)
+    ) {
+      cjk++;
+    } else if (code >= 0x0b80 && code <= 0x0bff) {
+      tamil++;
+    }
+  }
+  if (cjk / chars.length > 0.1) return "zh";
+  if (tamil / chars.length > 0.1) return "ta";
+
+  const tokens = text
+    .toLowerCase()
+    .split(/[^a-z']+/)
+    .filter(Boolean);
+  if (tokens.length === 0) return "en";
+
+  let msHits = 0;
+  let enHits = 0;
+  for (const t of tokens) {
+    if (MALAY_STOPWORDS.has(t)) msHits++;
+    else if (ENGLISH_STOPWORDS.has(t)) enHits++;
+  }
+
+  // Both languages present in force → bahasa rojak / Manglish.
+  if (msHits >= 2 && enHits >= 2) return "mixed";
+  if (msHits > enHits) return "ms";
+  return "en";
+}
diff --git a/src/lib/monitor/rss.ts b/src/lib/monitor/rss.ts
new file mode 100644
index 0000000..6117e88
--- /dev/null
+++ b/src/lib/monitor/rss.ts
@@ -0,0 +1,137 @@
+import type { FeedItem, MonitorSource } from "./types";
+
+/**
+ * Minimal dependency-free RSS 2.0 / Atom parser.
+ *
+ * Malaysian outlets publish a mix of RSS 2.0 (WordPress sites like FMT,
+ * Utusan, Sin Chew), Drupal feeds (NST, Berita Harian) and Atom (Reddit).
+ * This covers the common shapes of all three without pulling in an XML
+ * dependency — feeds are fetched server-side, so malformed input just
+ * yields fewer items, never a crash.
+ */
+
+const NAMED_ENTITIES: Record<string, string> = {
+  amp: "&",
+  lt: "<",
+  gt: ">",
+  quot: '"',
+  apos: "'",
+  nbsp: " ",
+  ndash: "–",
+  mdash: "—",
+  hellip: "…",
+  rsquo: "’",
+  lsquo: "‘",
+  rdquo: "”",
+  ldquo: "“",
+};
+
+export function decodeEntities(text: string): string {
+  return text
+    .replace(/&#x([0-9a-fA-F]+);/g, (_, hex) =>
+      String.fromCodePoint(parseInt(hex, 16))
+    )
+    .replace(/&#(\d+);/g, (_, dec) => String.fromCodePoint(parseInt(dec, 10)))
+    .replace(/&([a-zA-Z]+);/g, (m, name) => NAMED_ENTITIES[name] ?? m);
+}
+
+export function stripHtml(html: string): string {
+  // Decode first: Atom often ships entity-escaped HTML (&lt;p&gt;…), which
+  // must become real tags before they can be stripped.
+  return decodeEntities(html.replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, "$1"))
+    .replace(/<(script|style)[\s\S]*?<\/\1>/gi, " ")
+    .replace(/<[^>]+>/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+function firstTag(block: string, tags: string[]): string | null {
+  for (const tag of tags) {
+    const re = new RegExp(
+      `<${tag}(?:\\s[^>]*)?>([\\s\\S]*?)<\\/${tag}>`,
+      "i"
+    );
+    const m = block.match(re);
+    if (m) {
+      const inner = m[1].replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, "$1").trim();
+      if (inner) return inner;
+    }
+  }
+  return null;
+}
+
+/** Atom links live in the href attribute: <link rel="alternate" href="..."/> */
+function atomLink(block: string): string | null {
+  const links = block.match(/<link\b[^>]*>/gi) ?? [];
+  let fallback: string | null = null;
+  for (const tag of links) {
+    const href = tag.match(/href=["']([^"']+)["']/i)?.[1];
+    if (!href) continue;
+    const rel = tag.match(/rel=["']([^"']+)["']/i)?.[1];
+    if (!rel || rel === "alternate") return decodeEntities(href);
+    fallback = fallback ?? decodeEntities(href);
+  }
+  return fallback;
+}
+
+function parseDate(raw: string | null): string | null {
+  if (!raw) return null;
+  const d = new Date(decodeEntities(raw).trim());
+  return isNaN(d.getTime()) ? null : d.toISOString();
+}
+
+function parseBlock(block: string, source: MonitorSource): FeedItem | null {
+  const title = firstTag(block, ["title"]);
+  if (!title) return null;
+
+  let link = firstTag(block, ["link"]);
+  // RSS <link> holds text content; Atom <link/> is self-closing with href.
+  if (!link || link.startsWith("<")) link = atomLink(block);
+  if (!link) link = firstTag(block, ["guid"]);
+  if (!link || !/^https?:\/\//i.test(link.trim())) return null;
+
+  const description =
+    firstTag(block, ["description", "summary", "content:encoded", "content"]) ??
+    "";
+  const publishedAt = parseDate(
+    firstTag(block, ["pubDate", "published", "updated", "dc:date"])
+  );
+
+  // Google News appends " - Outlet Name" to titles and carries the outlet
+  // in a <source> tag — surface the real outlet instead of "Google News".
+  let sourceName = source.name;
+  let cleanTitle = stripHtml(title);
+  if (source.category === "aggregator") {
+    const outlet = firstTag(block, ["source"]);
+    if (outlet) {
+      sourceName = stripHtml(outlet);
+      const suffix = ` - ${sourceName}`;
+      if (cleanTitle.endsWith(suffix)) {
+        cleanTitle = cleanTitle.slice(0, -suffix.length).trim();
+      }
+    }
+  }
+
+  return {
+    title: cleanTitle,
+    link: decodeEntities(link.trim()),
+    description: stripHtml(description).slice(0, 500),
+    publishedAt,
+    sourceId: source.id,
+    sourceName,
+  };
+}
+
+export function parseFeed(xml: string, source: MonitorSource): FeedItem[] {
+  const blocks =
+    xml.match(/<item[\s>][\s\S]*?<\/item>/gi) ??
+    xml.match(/<entry[\s>][\s\S]*?<\/entry>/gi) ??
+    [];
+  const items: FeedItem[] = [];
+  for (const block of blocks) {
+    const item = parseBlock(block, source);
+    if (item) items.push(item);
+    if (items.length >= 50) break;
+  }
+  return items;
+}
