+"use client";
+
+import { useMemo } from "react";
+import { format, startOfDay, subDays } from "date-fns";
+import {
+  Bar,
+  BarChart,
+  CartesianGrid,
+  XAxis,
+  YAxis,
+} from "recharts";
+import {
+  Card,
+  CardContent,
+  CardDescription,
+  CardHeader,
+  CardTitle,
+} from "@/components/ui/card";
+import {
+  ChartContainer,
+  ChartLegend,
+  ChartLegendContent,
+  ChartTooltip,
+  ChartTooltipContent,
+  type ChartConfig,
+} from "@/components/ui/chart";
+import type { AnalyzedArticle, MonitorLanguage } from "@/lib/monitor/types";
+import {
+  LANGUAGE_COLORS,
+  LANGUAGE_LABELS,
+  SENTIMENT_COLORS,
+  SINGLE_SERIES_COLOR,
+} from "./colors";
+
+const sentimentConfig = {
+  positive: { label: "Positive", color: SENTIMENT_COLORS.positive },
+  neutral: { label: "Neutral", color: SENTIMENT_COLORS.neutral },
+  negative: { label: "Negative", color: SENTIMENT_COLORS.negative },
+} satisfies ChartConfig;
+
+const volumeConfig = {
+  count: { label: "Mentions", color: SINGLE_SERIES_COLOR },
+} satisfies ChartConfig;
+
+/** Sentiment-stacked daily mention volume for the trailing 7 days. */
+export function SentimentTimeline({
+  articles,
+}: {
+  articles: AnalyzedArticle[];
+}) {
+  const data = useMemo(() => {
+    const days = Array.from({ length: 7 }, (_, i) => {
+      const day = startOfDay(subDays(new Date(), 6 - i));
+      return {
+        key: day.getTime(),
+        day: format(day, "d MMM"),
+        positive: 0,
+        neutral: 0,
+        negative: 0,
+      };
+    });
+    for (const a of articles) {
+      if (!a.publishedAt) continue;
+      const t = startOfDay(new Date(a.publishedAt)).getTime();
+      const bucket = days.find((d) => d.key === t);
+      if (bucket) bucket[a.sentiment.label]++;
+    }
+    return days;
+  }, [articles]);
+
+  return (
+    <Card>
+      <CardHeader>
+        <CardTitle className="text-base">Mentions by day</CardTitle>
+        <CardDescription>Stacked by sentiment, last 7 days</CardDescription>
+      </CardHeader>
+      <CardContent>
+        <ChartContainer config={sentimentConfig} className="h-56 w-full">
+          <BarChart data={data} margin={{ top: 4, right: 4, left: -20 }}>
+            <CartesianGrid vertical={false} strokeOpacity={0.25} />
+            <XAxis
+              dataKey="day"
+              tickLine={false}
+              axisLine={false}
+              tickMargin={8}
+            />
+            <YAxis tickLine={false} axisLine={false} allowDecimals={false} />
+            <ChartTooltip content={<ChartTooltipContent />} />
+            <ChartLegend content={<ChartLegendContent />} />
+            <Bar
+              dataKey="positive"
+              stackId="s"
+              fill="var(--color-positive)"
+              stroke="hsl(var(--card))"
+              strokeWidth={1}
+              maxBarSize={40}
+            />
+            <Bar
+              dataKey="neutral"
+              stackId="s"
+              fill="var(--color-neutral)"
+              stroke="hsl(var(--card))"
+              strokeWidth={1}
+              maxBarSize={40}
+            />
+            <Bar
+              dataKey="negative"
+              stackId="s"
+              fill="var(--color-negative)"
+              stroke="hsl(var(--card))"
+              strokeWidth={1}
+              maxBarSize={40}
+              radius={[4, 4, 0, 0]}
+            />
+          </BarChart>
+        </ChartContainer>
+      </CardContent>
+    </Card>
+  );
+}
+
+/** Horizontal share-of-voice bars for the top publishing sources. */
+export function ShareOfVoice({ articles }: { articles: AnalyzedArticle[] }) {
+  const data = useMemo(() => {
+    const counts = new Map<string, number>();
+    for (const a of articles) {
+      counts.set(a.sourceName, (counts.get(a.sourceName) ?? 0) + 1);
+    }
+    return [...counts.entries()]
+      .sort((a, b) => b[1] - a[1])
+      .slice(0, 8)
+      .map(([source, count]) => ({ source, count }));
+  }, [articles]);
+
+  return (
+    <Card>
+      <CardHeader>
+        <CardTitle className="text-base">Share of voice</CardTitle>
+        <CardDescription>Top sources by mention count</CardDescription>
+      </CardHeader>
+      <CardContent>
+        <ChartContainer config={volumeConfig} className="h-56 w-full">
+          <BarChart
+            data={data}
+            layout="vertical"
+            margin={{ top: 4, right: 32, left: 8 }}
+          >
+            <CartesianGrid horizontal={false} strokeOpacity={0.25} />
+            <XAxis type="number" hide />
+            <YAxis
+              dataKey="source"
+              type="category"
+              tickLine={false}
+              axisLine={false}
+              width={120}
+              tick={{ fontSize: 11 }}
+            />
+            <ChartTooltip content={<ChartTooltipContent />} />
+            <Bar
+              dataKey="count"
+              fill="var(--color-count)"
+              radius={[0, 4, 4, 0]}
+              maxBarSize={14}
+              label={{
+                position: "right",
+                fill: "hsl(var(--muted-foreground))",
+                fontSize: 11,
+              }}
+            />
+          </BarChart>
+        </ChartContainer>
+      </CardContent>
+    </Card>
+  );
+}
+
+/** Language mix — fixed hue per language so filters never repaint it. */
+export function LanguageMix({ articles }: { articles: AnalyzedArticle[] }) {
+  const { data, config } = useMemo(() => {
+    const order: MonitorLanguage[] = ["ms", "en", "zh", "ta", "mixed"];
+    const counts = new Map<MonitorLanguage, number>();
+    for (const a of articles) {
+      counts.set(a.language, (counts.get(a.language) ?? 0) + 1);
+    }
+    const rows = order
+      .filter((l) => (counts.get(l) ?? 0) > 0)
+      .map((l) => ({
+        language: LANGUAGE_LABELS[l],
+        count: counts.get(l) ?? 0,
+        fill: LANGUAGE_COLORS[l],
+      }));
+    const cfg: ChartConfig = { count: { label: "Mentions" } };
+    return { data: rows, config: cfg };
+  }, [articles]);
+
+  return (
+    <Card>
+      <CardHeader>
+        <CardTitle className="text-base">Language mix</CardTitle>
+        <CardDescription>Mentions by language of coverage</CardDescription>
+      </CardHeader>
+      <CardContent>
+        <ChartContainer config={config} className="h-56 w-full">
+          <BarChart
+            data={data}
+            layout="vertical"
+            margin={{ top: 4, right: 32, left: 8 }}
+          >
+            <CartesianGrid horizontal={false} strokeOpacity={0.25} />
+            <XAxis type="number" hide />
+            <YAxis
+              dataKey="language"
+              type="category"
+              tickLine={false}
+              axisLine={false}
+              width={130}
+              tick={{ fontSize: 11 }}
+            />
+            <ChartTooltip content={<ChartTooltipContent />} />
+            <Bar
+              dataKey="count"
+              radius={[0, 4, 4, 0]}
+              maxBarSize={14}
+              label={{
+                position: "right",
+                fill: "hsl(var(--muted-foreground))",
+                fontSize: 11,
+              }}
+            />
+          </BarChart>
+        </ChartContainer>
+      </CardContent>
+    </Card>
+  );
+}
