+                    <X className="h-3 w-3" aria-hidden />
+                  </button>
+                </Badge>
+              ))}
+            </div>
+          )}
+        </CardContent>
+      </Card>
+
+      {/* ── Filters row ───────────────────────────────────────────── */}
+      <div className="flex flex-wrap items-center gap-2">
+        <Select
+          value={langFilter}
