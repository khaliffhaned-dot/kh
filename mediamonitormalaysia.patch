+/**
+ * Google News RSS scoped to Malaysia — used as keyword-search feeds so a
+ * tracked keyword still gets nationwide coverage beyond the curated list.
+ * `when:7d` keeps results inside the dashboard's 7-day window.
+ */
+export function googleNewsSources(query: string): MonitorSource[] {
+  const q = encodeURIComponent(`${query} when:7d`);
+  return [
+    {
+      id: "gnews-en",
+      name: "Google News MY (EN)",
+      feedUrl: `https://news.google.com/rss/search?q=${q}&hl=en-MY&gl=MY&ceid=MY:en`,
+      homepage: "https://news.google.com",
+      language: "en",
+      category: "aggregator",
+      region: "national",
+    },
+    {
+      id: "gnews-ms",
+      name: "Google News MY (BM)",
+      feedUrl: `https://news.google.com/rss/search?q=${q}&hl=ms-MY&gl=MY&ceid=MY:ms`,
+      homepage: "https://news.google.com",
+      language: "ms",
+      category: "aggregator",
+      region: "national",
+    },
+  ];
+}
+
+export function getSourceById(id: string): MonitorSource | undefined {
+  return MONITOR_SOURCES.find((s) => s.id === id);
+}
