@@ -0,0 +1,161 @@
+import type { SentimentResult } from "./types";
+
+/**
+ * Lexicon-based sentiment scoring built for Malaysian media text.
+ *
+ * Headlines and RSS summaries mix Bahasa Malaysia, English, Manglish slang
+ * and Chinese, so the lexicon covers all four registers. Scoring handles
+ * BM negators (tak/tidak/bukan/jangan) and intensifiers (memang/sangat/
+ * gila/giler) with a two-token negation window — a deliberate trade-off:
+ * transparent and free to run, rather than model-grade accuracy.
+ */
+
+const POSITIVE: Record<string, number> = {
+  // English
+  good: 1, great: 2, excellent: 2, best: 2, win: 2, wins: 2, won: 2,
+  success: 2, successful: 2, growth: 1, profit: 1, profits: 1, boost: 1,
+  improve: 1, improved: 1, improves: 1, improvement: 1, award: 1, awarded: 1,
+  praise: 2, praised: 2, support: 1, supports: 1, benefit: 1, benefits: 1,
+  strong: 1, stronger: 1, record: 1, surge: 1, gain: 1, gains: 1, rise: 1,
+  rises: 1, recovery: 1, recover: 1, breakthrough: 2, milestone: 1,
+  free: 1, safe: 1, safer: 1, peaceful: 1, thriving: 2, upgraded: 1,
+  approved: 1, launch: 1, launched: 1, expands: 1, expansion: 1,
+  celebrate: 1, celebrates: 1, historic: 1, proud: 1, happy: 1,
+  // Bahasa Malaysia
+  baik: 1, bagus: 2, hebat: 2, cemerlang: 2, terbaik: 2, mantap: 2,
+  menarik: 1, berjaya: 2, kejayaan: 2, untung: 1, keuntungan: 1,
+  meningkat: 1, peningkatan: 1, pujian: 2, memuji: 2, sokongan: 1,
+  menyokong: 1, bantuan: 1, membantu: 1, selamat: 1, aman: 1, mesra: 1,
+  murah: 1, percuma: 1, cekap: 1, telus: 1, adil: 1, harapan: 1, maju: 1,
+  kemajuan: 1, lonjakan: 1, pulih: 1, pemulihan: 1, tahniah: 2, gembira: 1,
+  bangga: 1, kagum: 2, selesa: 1, lancar: 1, berkualiti: 1, canggih: 1,
+  mampan: 1, rancak: 1, positif: 1, kukuh: 1, pengiktirafan: 1,
+  penambahbaikan: 1, diluluskan: 1, kemenangan: 2, juara: 2, rezeki: 1,
+  // Manglish / rojak slang
+  syok: 2, best_giler: 2, padu: 2, power: 2, gempak: 2, steady: 1,
+  terbaik_bossku: 2, ngam: 1, cun: 2, onz: 1, mantul: 2,
+  // Chinese (matched as substrings for zh text)
+  好: 1, 成功: 2, 增长: 1, 上涨: 1, 佳: 1, 优秀: 2, 胜利: 2, 荣获: 2,
+  庆祝: 1, 突破: 1, 受惠: 1, 免费: 1,
+};
+
+const NEGATIVE: Record<string, number> = {
+  // English
+  bad: 1, worst: 2, fail: 2, fails: 2, failed: 2, failure: 2,
+  corruption: 2, scandal: 2, fraud: 2, scam: 2, crash: 2, crisis: 2,
+  protest: 1, protests: 1, loss: 1, losses: 1, debt: 1, arrested: 2,
+  charged: 1, jailed: 2, killed: 2, dead: 2, death: 2, deaths: 2,
+  flood: 2, floods: 2, fire: 1, haze: 1, accident: 1, decline: 1,
+  plunge: 2, slump: 2, warning: 1, threat: 1, danger: 1, dangerous: 1,
+  victim: 1, victims: 1, abuse: 2, misuse: 2, controversy: 1,
+  backlash: 2, outrage: 2, boycott: 1, strike: 1, layoff: 2, layoffs: 2,
+  shutdown: 1, delay: 1, delayed: 1, delays: 1, leak: 1, leaked: 1,
+  probe: 1, probed: 1, summons: 1, fined: 1, murder: 2, robbery: 2,
+  theft: 1, missing: 1, collapse: 2, expensive: 1, inflation: 1,
+  jobless: 2, unemployment: 1, angry: 1, disappointed: 1, worried: 1,
+  // Bahasa Malaysia
+  buruk: 1, teruk: 2, lemah: 1, gagal: 2, kegagalan: 2, masalah: 1,
+  rasuah: 2, korupsi: 2, skandal: 2, penipuan: 2, tipu: 2, ditipu: 2,
+  curi: 2, kecurian: 2, rompak: 2, rompakan: 2, rogol: 2, bunuh: 2,
+  pembunuhan: 2, kemalangan: 1, maut: 2, banjir: 2, kebakaran: 2,
+  jerebu: 1, denda: 1, kompaun: 1, saman: 1, tangkap: 1, ditangkap: 2,
+  ditahan: 2, dakwaan: 1, didakwa: 1, krisis: 2, kontroversi: 1,
+  bantahan: 1, protes: 1, mogok: 1, rugi: 1, kerugian: 1, hutang: 1,
+  mahal: 1, inflasi: 1, pengangguran: 1, marah: 1, kecewa: 1, sedih: 1,
+  takut: 1, bimbang: 1, risau: 1, ancaman: 1, bahaya: 1, merosot: 1,
+  kemerosotan: 1, jatuh: 1, kejatuhan: 1, terjejas: 1, mangsa: 1,
+  penyelewengan: 2, amanah_pecah: 2, salahguna: 2, memalukan: 2, malu: 1,
+  kecoh: 1, sesak: 1, lambat: 1, tergendala: 1, terbakar: 2, lemas: 2,
+  dadah: 1, penyeludupan: 2, pergaduhan: 1, samseng: 1, negatif: 1,
+  ragut: 2, pecah: 1, musnah: 2, darurat: 2, wabak: 2, keracunan: 2,
+  // Manglish / rojak slang
+  bodoh: 2, bangang: 2, hampeh: 2, menyampah: 2, sial: 2, kantoi: 2,
+  potong_stim: 1, cilaka: 2, mampus: 2, koyak: 1, kena_tipu: 2,
+  // Chinese
+  贪污: 2, 丑闻: 2, 失败: 2, 逮捕: 2, 被捕: 2, 涨价: 1, 水灾: 2,
+  车祸: 2, 死亡: 2, 火灾: 2, 亏损: 1, 诈骗: 2, 罪: 1, 危机: 2, 抗议: 1,
+};
+
+// Multi-word slang is stored with underscores; normalise text the same way.
+const PHRASES: Array<[RegExp, string]> = [
+  [/\bbest\s+giler?\b/g, "best_giler"],
+  [/\bterbaik\s+bossku\b/g, "terbaik_bossku"],
+  [/\bpotong\s+stim\b/g, "potong_stim"],
+  [/\bkena\s+tipu\b/g, "kena_tipu"],
+  [/\bpecah\s+amanah\b/g, "amanah_pecah"],
+  [/\bsalah\s+guna\b/g, "salahguna"],
+];
+
+const NEGATORS = new Set([
+  "not", "no", "never", "without", "n't",
+  "tak", "tidak", "bukan", "jangan", "tiada", "belum", "kurang",
+]);
+
+const INTENSIFIERS = new Set([
+  "very", "so", "really", "extremely", "super", "damn", "totally",
+  "memang", "sangat", "amat", "terlalu", "paling", "gila", "giler",
+  "betul", "sungguh", "teramat", "habis",
+]);
+
+const CJK_RE = /[一-鿿]/;
+
+function scoreChinese(text: string): { score: number; signals: string[] } {
+  let score = 0;
+  const signals: string[] = [];
+  for (const [term, w] of Object.entries(POSITIVE)) {
+    if (CJK_RE.test(term) && text.includes(term)) {
+      score += w;
+      signals.push(term);
+    }
+  }
+  for (const [term, w] of Object.entries(NEGATIVE)) {
+    if (CJK_RE.test(term) && text.includes(term)) {
+      score -= w;
+      signals.push(term);
+    }
+  }
+  return { score, signals };
+}
+
+export function analyzeSentiment(rawText: string): SentimentResult {
+  let text = rawText.toLowerCase();
+  for (const [re, replacement] of PHRASES) {
+    text = text.replace(re, replacement);
+  }
+
+  let score = 0;
+  const signals: string[] = [];
+
+  const tokens = text.split(/[^a-z_']+/).filter(Boolean);
+  for (let i = 0; i < tokens.length; i++) {
+    const token = tokens[i];
+    let weight = POSITIVE[token] ?? -(NEGATIVE[token] ?? 0);
+    if (weight === 0) continue;
+
+    // Negation window: "tak bagus", "not very good", "bukan mudah".
+    const prev1 = tokens[i - 1];
+    const prev2 = tokens[i - 2];
+    const negated =
+      (prev1 && NEGATORS.has(prev1)) ||
+      (prev2 && NEGATORS.has(prev2) && prev1 && INTENSIFIERS.has(prev1));
+    if (negated) weight = -weight;
+
+    if (prev1 && INTENSIFIERS.has(prev1)) weight *= 1.5;
+
+    score += weight;
+    signals.push(negated ? `${prev1} ${token}` : token);
+  }
+
+  if (CJK_RE.test(rawText)) {
+    const zh = scoreChinese(rawText);
+    score += zh.score;
+    signals.push(...zh.signals);
+  }
+
+  // Squash into [-1, 1]; ±2 raw score saturates most of the range.
+  const normalized = Math.max(-1, Math.min(1, score / 3));
+  const label =
+    normalized > 0.15 ? "positive" : normalized < -0.15 ? "negative" : "neutral";
+
+  return { label, score: Number(normalized.toFixed(3)), signals: signals.slice(0, 8) };
+}
